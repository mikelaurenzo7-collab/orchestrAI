# ═══════════════════════════════════════════════════════════════
# orchestrAI Backend Environment Configuration
# ═══════════════════════════════════════════════════════════════

# ─────────────────── Core Configuration ───────────────────
ENV=development  # development | production
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000  # Your backend URL (for OAuth callbacks)
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006  # Comma-separated CORS origins

# ─────────────────── Database ───────────────────
MONGO_URL=mongodb://localhost:27017  # MongoDB connection string
DB_NAME=orchestrai  # Database name

# ─────────────────── Authentication & Security ───────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production  # Min 32 chars recommended
ADMIN_EMAIL=admin@yourdomain.com  # Admin account email
ADMIN_PASSWORD=ChangeThisPassword123!  # Admin account password

# ─────────────────── AI & LLM ───────────────────
EMERGENT_LLM_KEY=your-emergent-llm-api-key  # Emergent AI API key
LLM_RATE_LIMIT=30  # Max LLM requests per minute per user

# ═══════════════════════════════════════════════════════════════
# E-COMMERCE PLATFORM INTEGRATIONS (OAuth)
# ═══════════════════════════════════════════════════════════════

# ─────────────────── Shopify ───────────────────
# Get these from: https://partners.shopify.com/organizations
SHOPIFY_PARTNER_CLIENT_ID=your-shopify-client-id
SHOPIFY_PARTNER_CLIENT_SECRET=your-shopify-client-secret
SHOPIFY_CLI_TOKEN=your-shopify-cli-token  # For programmatic store creation

# ─────────────────── Etsy ───────────────────
# Get these from: https://www.etsy.com/developers/register
ETSY_API_KEY=your-etsy-api-key-v3

# ─────────────────── eBay ───────────────────
# Get these from: https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=your-ebay-client-id
EBAY_CLIENT_SECRET=your-ebay-client-secret
EBAY_RUNAME=your-ebay-runame  # eBay redirect URL name

# ═══════════════════════════════════════════════════════════════
# SOCIAL MEDIA INTEGRATIONS
# ═══════════════════════════════════════════════════════════════

# ─────────────────── Twitter / X ───────────────────
# Get these from: https://developer.twitter.com/en/portal/dashboard
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_TOKEN_SECRET=your-twitter-access-token-secret
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# ─────────────────── Pinterest ───────────────────
# Get these from: https://developers.pinterest.com/apps/
PINTEREST_ACCESS_TOKEN=your-pinterest-access-token
PINTEREST_APP_ID=your-pinterest-app-id

# ─────────────────── TikTok ───────────────────
# Get these from: https://developers.tiktok.com/apps/
TIKTOK_CLIENT_KEY=your-tiktok-client-key

# ─────────────────── Meta (Facebook & Instagram) ───────────────────
# Get these from: https://developers.facebook.com/apps/
META_APP_ID=your-meta-app-id

# ─────────────────── Reddit ───────────────────
# Get these from: https://www.reddit.com/prefs/apps
# Create an OAuth app (NOT Devvit - that's different)
# App type: "web app" or "script"
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=orchestrAI:v1.0.0 (by /u/yourusername)  # Required by Reddit API
REDDIT_USERNAME=your-reddit-username  # For posting
REDDIT_PASSWORD=your-reddit-password  # For posting (use app passwords if available)

# ═══════════════════════════════════════════════════════════════
# BUSINESS TOOL INTEGRATIONS
# ═══════════════════════════════════════════════════════════════

# ─────────────────── Google Workspace ───────────────────
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id

# ─────────────────── Microsoft 365 ───────────────────
# Get these from: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=your-microsoft-client-id

# ─────────────────── Stripe ───────────────────
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# ─────────────────── HubSpot ───────────────────
# Get these from: https://app.hubspot.com/developer
HUBSPOT_API_KEY=your-hubspot-api-key

# ─────────────────── Slack ───────────────────
# Get these from: https://api.slack.com/apps
SLACK_CLIENT_ID=your-slack-client-id

# ─────────────────── Notion ───────────────────
# Get these from: https://www.notion.so/my-integrations
NOTION_INTEGRATION_SECRET=your-notion-integration-secret

# ─────────────────── Mailjet ───────────────────
# Get these from: https://app.mailjet.com/account/api_keys
MAILJET_API_KEY=your-mailjet-api-key
